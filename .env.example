CANVAS_BASE_URL=https://aiu.instructure.com

# Recommended mode: create this in Canvas from Account > Settings > New Access Token.
# Never commit or share the real token.
CANVAS_ACCESS_TOKEN=

# Browser mode: use this when Canvas access tokens are unavailable.
# 1. Run: npm run chrome
# 2. Log in to AIU Canvas in the Chrome window that opens.
# 3. Start this MCP server with CANVAS_AUTH_MODE=chrome.
CANVAS_AUTH_MODE=token
CHROME_DEBUG_URL=http://127.0.0.1:9222
CANVAS_REQUEST_TIMEOUT_MS=30000

# Optional: where downloaded Canvas files are written.
CANVAS_DOWNLOAD_DIR=downloads
