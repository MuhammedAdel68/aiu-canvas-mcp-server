{
  "name": "aiu-canvas-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for retrieving AIU Canvas course content through the Canvas API or an authenticated Chrome session.",
  "type": "module",
  "private": true,
  "bin": {
    "aiu-canvas-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "chrome": "powershell -ExecutionPolicy Bypass -File ./scripts/start-chrome-debug.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "playwright-core": "^1.59.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
